# Maintainer: Claritys11 <https://github.com/Claritys11>
pkgname=islet-git
pkgver=1.10.1
pkgrel=1
pkgdesc="Notchy-style dynamic island, synced karaoke lyrics, Pomodoro and Notion checklist for Quickshell"
arch=('any')
url="https://github.com/Claritys11/islet"
license=('MIT')
depends=('quickshell' 'curl')
makedepends=('git')
optdepends=('cava: real audio visualizer in the notch'
            'python: Spicy Lyrics bridge, DankMaterialShell setup (islet spicetify, islet dms)'
            'wl-clipboard: paste onto the Shelf'
            'spicetify-cli: Spicy Lyrics bridge'
            'libnotify: Pomodoro notifications'
            'pipewire: Pomodoro sound (pw-play)')
provides=('islet')
conflicts=('islet')
source=("islet::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd islet
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd islet
    # Quickshell finds configs in $XDG_CONFIG_DIRS, so `qs -c islet` works system-wide.
    install -d "$pkgdir/etc/xdg/quickshell/islet"
    # Everything the QML loads or runs next to itself (modules, scripts, the
    # DMS plugins and their symlinks into link/).
    cp -r -- *.qml assets bin bridge finder integrations link media shelf spicetify today "$pkgdir/etc/xdg/quickshell/islet/"
    install -Dm755 bin/islet "$pkgdir/usr/bin/islet"
    install -Dm644 dist/islet.service "$pkgdir/usr/lib/systemd/user/islet.service"
    install -Dm644 dist/islet-settings.desktop "$pkgdir/usr/share/applications/islet-settings.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
